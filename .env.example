# Copy to .env (gitignored). Never commit the real file.

# Spotify app Client ID (https://developer.spotify.com/dashboard). No client secret needed (PKCE).
SPOTIFY_CLIENT_ID=

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Cloud service account JSON key with Text-to-Speech access (only for tts.provider = "google")
GOOGLE_APPLICATION_CREDENTIALS=/home/you/.config/ai-radio-host/gcp-tts-key.json

# Optional: contact (URL or email) sent in the User-Agent to Wikipedia/MusicBrainz, as they request
RADIOHOST_CONTACT=

# Only needed if your API key is not scoped to a workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

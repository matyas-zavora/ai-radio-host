# Copy to .env (gitignored). Never commit the real file.

# Spotify app Client ID (https://developer.spotify.com/dashboard). No client secret needed (PKCE).
SPOTIFY_CLIENT_ID=

# Anthropic API key (https://platform.claude.com/settings/keys); not needed with a local Ollama model
ANTHROPIC_API_KEY=

# Google Cloud service account JSON key with Text-to-Speech access (only for Google voices)
# GOOGLE_APPLICATION_CREDENTIALS=/home/you/.config/ai-radio-host/gcp-tts-key.json

# Optional: your contact (URL or email), added to the User-Agent sent to Wikipedia/MusicBrainz
RADIOHOST_CONTACT=

# Only needed if your API key is not scoped to a workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
